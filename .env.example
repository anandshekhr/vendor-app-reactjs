# Main API (api-services) origin, without trailing slash
VITE_API_BASE_URL=http://localhost:8000
# All vendor endpoints, including POS, are served by api-services. Set only if POS runs on a separate host
# (e.g. the standalone tnbs-vendor-service).
VITE_VENDOR_API_BASE_URL=
# WebSocket origin for live chat (Django Channels). Defaults to VITE_API_BASE_URL with ws(s)://.
VITE_WS_BASE_URL=
# Development-only in-browser mock API
VITE_USE_MOCK_API=false
# Reserved for the delivery map (disabled until the backend exposes vendor-scoped rider coordinates)
VITE_GOOGLE_MAPS_API_KEY=
# Offline POS policy
VITE_OFFLINE_PAYMENT_METHODS=cash
VITE_POS_STALE_CATALOGUE_MINUTES=60
# Set to true only once POS checkout honours the Idempotency-Key header (see API_MAPPING.md G-9)
VITE_POS_SERVER_IDEMPOTENCY=false
# Polling interval for new orders/bookings/chat (ms)
VITE_POLL_INTERVAL_MS=20000
